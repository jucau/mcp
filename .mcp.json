{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "php",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "library": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "php",
                "php",
                "artisan",
                "mcp:start",
                "library"
            ]
        }
    }
}
