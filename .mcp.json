{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "php",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "library": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "php",
                "php",
                "artisan",
                "mcp:start",
                "library"
            ]
        },
        "library-http": {
            "type": "http",
            "url": "http://127.0.0.1:8090/mcp"
        }
    }
}
